<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical"
    android:padding="12dp" android:background="@drawable/widget_background">
    <TextView android:id="@+id/widget_title" android:layout_width="match_parent" android:layout_height="40dp"
        android:text="@string/app_name" android:textColor="#332900" android:textSize="20sp" android:textStyle="bold" android:gravity="center_vertical" />
    <TextView android:id="@+id/widget_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="36dp" android:text="@string/quick_service_hint" android:textColor="#332900" android:textSize="14sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/widget_fare_1" style="@style/WidgetFareButton" android:text="@string/widget_preview_5" />
        <Button android:id="@+id/widget_fare_2" style="@style/WidgetFareButton" android:text="@string/widget_preview_6" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <Button android:id="@+id/widget_fare_3" style="@style/WidgetFareButton" android:text="@string/widget_preview_7" />
        <Button android:id="@+id/widget_fare_4" style="@style/WidgetFareButton" android:text="@string/widget_preview_10" />
    </LinearLayout>
    <LinearLayout android:id="@+id/widget_paging" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical">
        <Button android:id="@+id/widget_previous" style="@style/WidgetSmallButton" android:text="@string/widget_previous" />
        <TextView android:id="@+id/widget_page" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#332900" />
        <Button android:id="@+id/widget_next" style="@style/WidgetSmallButton" android:text="@string/widget_next" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="52dp" android:orientation="horizontal">
        <Button android:id="@+id/widget_other" style="@style/WidgetSmallButton" android:text="@string/other_amount" />
        <Button android:id="@+id/widget_undo" style="@style/WidgetSmallButton" android:text="@string/undo" android:visibility="gone" />
    </LinearLayout>
</LinearLayout>
