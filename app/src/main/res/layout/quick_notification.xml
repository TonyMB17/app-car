<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/notification_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="32dp" android:gravity="center_vertical" android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
        <Button android:id="@+id/notification_fare_1" style="@style/NotificationFareButton" />
        <Button android:id="@+id/notification_fare_2" style="@style/NotificationFareButton" />
        <Button android:id="@+id/notification_fare_3" style="@style/NotificationFareButton" />
        <Button android:id="@+id/notification_fare_4" style="@style/NotificationFareButton" />
    </LinearLayout>
    <LinearLayout android:id="@+id/notification_paging" android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
        <Button android:id="@+id/notification_previous" style="@style/NotificationFareButton" android:text="@string/widget_previous" />
        <TextView android:id="@+id/notification_page" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textAppearance="@android:style/TextAppearance.Material.Notification" />
        <Button android:id="@+id/notification_next" style="@style/NotificationFareButton" android:text="@string/widget_next" />
    </LinearLayout>
</LinearLayout>
